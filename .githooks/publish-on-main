#!/bin/sh
# Shared body of post-commit / post-merge: run tools/publish.ps1 on branch main.
# Uses Windows PowerShell 5.1 (present on every Windows PC) so the publish
# path is exercised with the same engine a fresh PC has.
hook="${1:-hook}"
branch=$(git symbolic-ref --short -q HEAD)
[ "$branch" = "main" ] || exit 0

root=$(git rev-parse --show-toplevel)
if ! command -v powershell.exe >/dev/null 2>&1; then
    echo "[$hook] publish skipped: powershell.exe not found"
    exit 0
fi

echo "[$hook] publishing kit to OneDrive..."
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/tools/publish.ps1"
rc=$?
case $rc in
    0) ;;
    2) echo "[$hook] publish blocked by drift guard - see above (commit is fine)" ;;
    *) echo "[$hook] publish failed (exit $rc) - commit is fine; run tools/publish.ps1 by hand" ;;
esac
exit 0
